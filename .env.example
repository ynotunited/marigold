# ============================================================
# Marigold Signature Commerce Platform — Environment Config
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
APP_NAME="Marigold Signature Nigeria Limited"
APP_URL=https://marigoldsignature.com
APP_ENV=development
# MUST be set to false in production (prevents stack traces from leaking)
APP_DEBUG=false
APP_KEY=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING
APP_TIMEZONE=Africa/Lagos
# Put a maintenance notice file at .maintenance OR set to true to enable maintenance mode
APP_MAINTENANCE=false

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=marigold_db
DB_USER=root
DB_PASS=

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=your@email.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="Marigold Signature"
SMTP_FROM_EMAIL=hello@marigoldsignature.com

# Paystack
PAYSTACK_PUBLIC_KEY=pk_test_
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_CALLBACK_URL=http://localhost/ms/public/payment/callback

# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel
META_PIXEL_ID=

# WhatsApp
WHATSAPP_NUMBER=234XXXXXXXXXX

# Storage
UPLOAD_MAX_SIZE=20971520
UPLOAD_PATH=../public/uploads

# Cache
CACHE_DRIVER=file
CACHE_TTL=3600

# Session
# SESSION_SECURE=true when served over HTTPS (production)
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_NAME=ms_sess
# Inactivity timeout in seconds (default 3600 = 1 hour)
SESSION_TIMEOUT=3600
# Absolute session lifetime in seconds (default 28800 = 8 hours)
SESSION_ABSOLUTE_TTL=28800
# bcrypt cost factor (10-12 recommended)
BCRYPT_COST=12
