# ============================================================
# Marigold Signature Commerce Platform — Environment Config
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# APP_ENV controls which configuration profile is active.
# Valid values: development | production | staging | testing
# ============================================================

# ─── Application ───────────────────────────────────────────
APP_NAME="Marigold Signature Nigeria Limited"
APP_ENV=development
APP_DEBUG=true
APP_KEY=
APP_TIMEZONE=Africa/Lagos

# Base URL — include protocol, no trailing slash.
# Development: https://ms.test  (or http://localhost/ms/public)
# Production:  https://marigold.gt.tc
APP_URL=https://ms.test

# Live payments — set to true ONLY in production with real gateway keys.
# In development/staging, all gateways use sandbox/test mode regardless.
APP_LIVE_PAYMENTS=false

# Mail sending — defaults to disabled in dev/staging.
# Set to true to actually send emails in non-production environments.
APP_MAIL_ENABLED=false

# ─── Database ──────────────────────────────────────────────
# Development and production MUST use different DB_NAME values
# so dev actions (seeding, test payments, etc.) never touch prod data.
#
#   Development:  marigold_dev   (or marigold_db on your local machine)
#   Production:   marigold_prod  (set on the InfinityFree hosting panel)
#
# DB_USER / DB_PASS / DB_HOST are typically different between
# environments — InfinityFree assigns its own credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=marigold_dev
DB_USER=root
DB_PASS=

# ─── SMTP Email ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="Marigold Signature"
SMTP_FROM_EMAIL=hello@marigoldsignatureng.com

# ─── SMS (Termii default, or set to twilio) ────────────────
SMS_PROVIDER=termii
SMS_API_KEY=
SMS_SENDER_ID=Marigold
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ─── Paystack ──────────────────────────────────────────────
# Use test keys in development, live keys in production.
# NEVER mix them up — a test key in production means no real charges.
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_CALLBACK_URL=http://localhost/ms/public/payment/callback

# ─── Flutterwave (alternative online gateway) ──────────────
# Get keys at https://dashboard.flutterwave.com (Settings -> API).
# Test keys start with FLWSECK_TEST-.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ─── ShipBubble Logistics ─────────────────────────────────
# Get keys at https://app.shipbubble.com/register (Settings -> API keys & Webhook).
# Sandbox keys start with sb_sandbox_, live keys with sb_prod_.
SHIPBUBBLE_API_KEY=
SHIPBUBBLE_WEBHOOK_SECRET=
SHIPBUBBLE_SENDER_ADDRESS_CODE=
SHIPBUBBLE_DEFAULT_CATEGORY_ID=90097994
SHIPBUBBLE_PACKAGE_LENGTH=20
SHIPBUBBLE_PACKAGE_WIDTH=15
SHIPBUBBLE_PACKAGE_HEIGHT=10

# ─── Google Analytics ──────────────────────────────────────
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Meta Pixel ────────────────────────────────────────────
META_PIXEL_ID=

# ─── WhatsApp ──────────────────────────────────────────────
WHATSAPP_NUMBER=2348130270391

# ─── Storage ───────────────────────────────────────────────
UPLOAD_MAX_SIZE=20971520
UPLOAD_PATH=../public/uploads

# ─── Cache ─────────────────────────────────────────────────
CACHE_DRIVER=file
CACHE_TTL=3600

# ─── Session ───────────────────────────────────────────────
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_TIMEOUT=3600
SESSION_ABSOLUTE_TTL=28800

# ─── Security ──────────────────────────────────────────────
BCRYPT_COST=12

# ─── Maintenance Mode ──────────────────────────────────────
# Set to true to serve a 503 maintenance page.
APP_MAINTENANCE=false
