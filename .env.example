# ============================================================
# Marigold Signature Commerce Platform — Environment Config
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
APP_NAME="Marigold Signature Nigeria Limited"
APP_URL=https://marigoldsignatureng.com
APP_ENV=development
# MUST be set to false in production (prevents stack traces from leaking)
APP_DEBUG=false
APP_KEY=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING
APP_TIMEZONE=Africa/Lagos
# Put a maintenance notice file at .maintenance OR set to true to enable maintenance mode
APP_MAINTENANCE=false

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=marigold_db
DB_USER=root
DB_PASS=

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=your@email.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="Marigold Signature"
SMTP_FROM_EMAIL=hello@marigoldsignatureng.com

# Paystack
PAYSTACK_PUBLIC_KEY=pk_test_
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_CALLBACK_URL=http://localhost/ms/public/payment/callback

# Flutterwave (alternative online gateway)
# Get keys at https://dashboard.flutterwave.com (Settings -> API). Test keys
# start with FLWSECK_TEST-. Leave blank to run the checkout in simulated mode.
FLUTTERWAVE_SECRET_KEY=
# Secret hash set under Settings -> Webhooks. Used to verify the verif-hash
# header on incoming webhooks at /api/webhooks/flutterwave.
FLUTTERWAVE_WEBHOOK_HASH=

# ShipBubble Logistics (courier delivery rates + labels)
# Get keys at https://app.shipbubble.com/register (Settings -> API keys & Webhook)
# Sandbox keys start with sb_sandbox_, live keys with sb_prod_. Leave blank to run
# the checkout in simulated demo mode (sample rates, no real labels).
SHIPBUBBLE_API_KEY=
# Webhook SECRET_KEY (Settings -> API keys & Webhook). Used to verify x-ship-signature.
SHIPBUBBLE_WEBHOOK_SECRET=
# Address code of your pickup address (from the ShipBubble Addresses API).
# Leave blank to auto-resolve it at runtime by validating SHIPBUBBLE_SENDER_ADDRESS
# (cached for 30 days).
SHIPBUBBLE_SENDER_ADDRESS_CODE=
# Optional sender details used for runtime sender-address resolution.
SHIPBUBBLE_SENDER_ADDRESS=
SHIPBUBBLE_SENDER_NAME=
SHIPBUBBLE_SENDER_EMAIL=
SHIPBUBBLE_SENDER_PHONE=
# Optional defaults for the rate request. Category IDs differ per account, so a
# configured value is only used when it exists in the account's live category
# list; otherwise "Light weight items" is chosen automatically (cached 7 days).
SHIPBUBBLE_DEFAULT_CATEGORY_ID=90097994
SHIPBUBBLE_PACKAGE_LENGTH=20
SHIPBUBBLE_PACKAGE_WIDTH=15
SHIPBUBBLE_PACKAGE_HEIGHT=10

# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel
META_PIXEL_ID=

# WhatsApp
WHATSAPP_NUMBER=234XXXXXXXXXX

# Storage
UPLOAD_MAX_SIZE=20971520
UPLOAD_PATH=../public/uploads

# Cache
CACHE_DRIVER=file
CACHE_TTL=3600

# Session
# SESSION_SECURE=true when served over HTTPS (production)
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_NAME=ms_sess
# Inactivity timeout in seconds (default 3600 = 1 hour)
SESSION_TIMEOUT=3600
# Absolute session lifetime in seconds (default 28800 = 8 hours)
SESSION_ABSOLUTE_TTL=28800
# bcrypt cost factor (10-12 recommended)
BCRYPT_COST=12
